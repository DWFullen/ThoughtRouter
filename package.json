{
  "name": "thoughtrouter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @thoughtrouter/api --filter @thoughtrouter/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @thoughtrouter/web test:e2e",
    "db:migrate": "pnpm --filter @thoughtrouter/db db:migrate",
    "db:seed": "pnpm --filter @thoughtrouter/db db:seed",
    "github:doctor": "pnpm --filter @thoughtrouter/github github:doctor"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
